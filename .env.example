ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENABLE_DEBUG_ENDPOINTS=true
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_MAX_WORDS=60
CHUNK_OVERLAP_SENTENCES=1
TOP_K=5
EVIDENCE_THRESHOLD=0.35
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=15
LLM_CONNECT_TIMEOUT_SECONDS=3
FORCE_IPV4=true
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=3
LLM_MIN_INTERVAL_SECONDS=0
PROMPT_VERSION=v3
VERIFY_ANSWERS=false
QUERY_ANALYSIS_ENABLED=true
GENERATION_MAX_TOKENS=700
HISTORY_MAX_TURNS=6
PHYSIO_API_BASE_URL=http://localhost:3000/api/v1
PHYSIO_API_TIMEOUT_SECONDS=8
DATA_TOOLS_ENABLED=true
TOOL_MAX_ITEMS=15
TIMEZONE=America/Sao_Paulo
ACTIONS_ENABLED=true
ASSISTANT_SIGNING_SECRET=
PROPOSAL_TTL_SECONDS=300
DEFAULT_APPOINTMENT_MINUTES=60
PATIENT_ACTIONS_ENABLED=true
